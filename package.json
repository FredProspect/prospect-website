{
  "name": "prospect-public-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node web/build.mjs && node scripts/build.mjs",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --check server.mjs && node --check assets/site.js && node --check scripts/build.mjs && node --check scripts/pages.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "export:waitlist": "node scripts/export-waitlist.mjs",
    "test:motion": "node tests/motion.mjs",
    "build:web": "node web/build.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "gsap": "3.13",
    "lenis": "^1.3.28",
    "lighthouse": "^13.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
