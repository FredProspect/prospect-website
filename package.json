{
  "name": "prospect-public-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "check": "node --check server.mjs && node --check assets/site.js && node --check assets/motion.js && node --check assets/intelligence-visual.js && node --check scripts/build.mjs",
