# Node 24, one replica, durable private mounted volume (never ephemeral storage).
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://prospectpartnership.co.uk
WAITLIST_DB=/var/lib/prospect/waitlist.sqlite
# Random secret at least 32 characters, stored only in hosting secrets.
WAITLIST_RATE_SECRET=
# Enable only behind a trusted proxy which overwrites X-Real-IP.
TRUST_PROXY=0
# Only when using the dedicated Railway public collector alongside GitHub Pages.
ADDITIONAL_PUBLIC_ORIGIN=https://prospect-public-website-staging.up.railway.app
# Log only aggregate saved/duplicate events, never addresses or payloads.
LOG_WAITLIST_EVENTS=1
# Email confirmation (optional). Off unless both are set. Values live only in Railway variables.
RESEND_API_KEY=
MAIL_FROM=Prospect <waitlist@prospectpartnership.co.uk>
# Public origin of this collector, used to build confirmation links.
COLLECTOR_ORIGIN=https://prospect-public-website-staging.up.railway.app
# Optional ranked CSV export at /api/waitlist/export (32+ random characters).
WAITLIST_ADMIN_TOKEN=
# Optional: where replies to confirmation emails go (a real, monitored inbox).
MAIL_REPLY_TO=
