# Node 24, one replica, durable private mounted volume (never ephemeral storage).
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=https://prospectpartnership.co.uk
WAITLIST_DB=/var/lib/prospect/waitlist.sqlite
# Random secret at least 32 characters, stored only in hosting secrets.
WAITLIST_RATE_SECRET=
# Enable only behind a trusted proxy which overwrites X-Forwarded-For.
TRUST_PROXY=0
